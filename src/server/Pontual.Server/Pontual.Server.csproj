<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.10.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Roteiros operacionais que a assistente recebe na primeira subida do servidor (um arquivo por banco). -->
    <Content Include="roteiros-iniciais\**\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pontual.Domain\Pontual.Domain.csproj" />
    <ProjectReference Include="..\Pontual.Infrastructure\Pontual.Infrastructure.csproj" />
    <ProjectReference Include="..\Pontual.Contracts\Pontual.Contracts.csproj" />
  </ItemGroup>

</Project>
