{
  "name": "pontual-agenthub",
  "private": true,
  "version": "0.1.0",
  "description": "Central dos Agentes do Terminal Pontual: escritório 2D que mostra os agentes reais do Claude Code.",
  "type": "module",
  "scripts": {
    "start": "npm run build && node server/index.mjs",
    "server": "node server/index.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"server/*.test.mjs\" \"../../tools/agent-events/*.test.mjs\""
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
