<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>Terminal Pontual</AssemblyTitle>
    <Product>Terminal Pontual</Product>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pontual.Terminal.Ipc\Pontual.Terminal.Ipc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tela inicial embutida (modo local): os mesmos arquivos que o servidor publica em /terminal/, por link. -->
    <Content Include="..\..\server\Pontual.Server\wwwroot\terminal\**\*" Link="terminal\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Lista de sites do modo local. O TI pode editar o arquivo ao lado do programa. -->
    <Content Include="config-local.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
