<Application x:Class="Pontual.Terminal.Shell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Cores e fonte da marca, as mesmas do protótipo aprovado (prototipos/index.html). -->
        <SolidColorBrush x:Key="Azul900" Color="#0A2F6B" />
        <SolidColorBrush x:Key="Azul700" Color="#0D47A1" />
        <SolidColorBrush x:Key="Azul500" Color="#1976D2" />
        <SolidColorBrush x:Key="Azul100" Color="#E3EFFC" />
        <SolidColorBrush x:Key="Azul50" Color="#F3F8FE" />
        <SolidColorBrush x:Key="Verde700" Color="#1F7A45" />
        <SolidColorBrush x:Key="Verde500" Color="#2E9E5B" />
        <SolidColorBrush x:Key="Tinta" Color="#0F172A" />
        <SolidColorBrush x:Key="Texto" Color="#334155" />
        <SolidColorBrush x:Key="Suave" Color="#64748B" />
        <SolidColorBrush x:Key="Apagado" Color="#94A3B8" />
        <SolidColorBrush x:Key="Linha" Color="#E6EBF2" />
        <SolidColorBrush x:Key="LinhaForte" Color="#CFD8E3" />
        <SolidColorBrush x:Key="Fundo" Color="#F7F9FC" />
        <SolidColorBrush x:Key="Rubi700" Color="#B91C1C" />
        <SolidColorBrush x:Key="Rubi100" Color="#FEE2E2" />
        <SolidColorBrush x:Key="Ambar700" Color="#B45309" />
        <SolidColorBrush x:Key="Ambar100" Color="#FEF3C7" />
        <FontFamily x:Key="FonteMarca">Poppins, Segoe UI</FontFamily>

        <Style x:Key="AnelDeFoco">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-4" RadiusX="24" RadiusY="24" Stroke="{StaticResource Azul500}" StrokeThickness="3" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão em forma de pílula (.btn do protótipo). -->
        <Style x:Key="BotaoPilula" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Azul700}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AnelDeFoco}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Caixa" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Caixa" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Caixa" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Caixa" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BotaoClaro" TargetType="Button" BasedOn="{StaticResource BotaoPilula}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource Tinta}" />
            <Setter Property="BorderBrush" Value="{StaticResource LinhaForte}" />
        </Style>
        <Style x:Key="BotaoVerde" TargetType="Button" BasedOn="{StaticResource BotaoPilula}">
            <Setter Property="Background" Value="{StaticResource Verde500}" />
        </Style>

        <!-- Botão sem moldura: abas e ícones da barra. -->
        <Style x:Key="BotaoLimpo" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Suave}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AnelDeFoco}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Caixa" Background="{TemplateBinding Background}" CornerRadius="22" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Caixa" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Campo" TargetType="TextBox">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource Tinta}" />
            <Setter Property="BorderBrush" Value="{StaticResource LinhaForte}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Caixa" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Caixa" Property="BorderBrush" Value="{StaticResource Azul500}" />
                                <Setter TargetName="Caixa" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Caixa" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
