<?xml version="1.0" encoding="utf-8"?>
<!-- Terminal Pontual para Android: versão de teste. Compilado por compilar.ps1, sem Gradle. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="br.com.pontualconsig.terminal">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Vigia de aplicativos (AppGuard). Os dois primeiros são acessos especiais: o Android não os dá sozinho;
      o instalar.ps1 libera pelo cabo (appops). Sem eles o vigia fica parado e o resto funciona.
        PACKAGE_USAGE_STATS: saber qual aplicativo está na frente.
        SYSTEM_ALERT_WINDOW: poder trazer o Terminal de volta quando ele está em segundo plano.
        QUERY_ALL_PACKAGES: mostrar o nome do aplicativo não autorizado (e não só o identificador).
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Para o app conseguir ver se o WhatsApp está instalado e abri-lo. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <!--
      usesCleartextTraffic: a Central do TI usa HTTP, sem TLS, dentro da rede da empresa (docs/V1-CONTRATO.md, seção 7).
      Sem testOnly: o app instala e aparece como um app normal (pelo download via Wi-Fi). A saída do bloqueio
      é feita pelo próprio app (Lock.remove: remove o administrador e o dono do aparelho de si mesmo) ou
      desinstalando; não depende mais do "adb dpm remove-active-admin".
    -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Faz o botão de início do Android voltar para o Terminal. Nasce desligado: só é ligado quando o
          bloqueio é aplicado (classe Lock), e é desligado de novo quando o bloqueio é removido.
        -->
        <activity-alias
            android:name=".Inicio"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Mantem a ligacao do aparelho com a Central do TI da empresa" />
        </service>
    </application>
</manifest>
