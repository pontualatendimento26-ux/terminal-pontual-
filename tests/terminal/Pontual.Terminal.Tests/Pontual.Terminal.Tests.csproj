<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows: o cadastro local é testado com a DPAPI de verdade. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\terminal\Pontual.Terminal.Ipc\Pontual.Terminal.Ipc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- O arquivo distribuído com o programa também é conferido pelos testes. -->
    <None Include="..\..\..\src\terminal\Pontual.Terminal.Shell\config-local.json" Link="config-local.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
